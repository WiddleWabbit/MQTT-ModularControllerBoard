    {
      "description": "Zip Gerbers",
      "id": "f9996d6f-b474-47ab-b3c7-da601945c633",
      "settings": {
        "command": "powershell.exe -Command \"\n\n$tmp_location = '${JOBSET_OUTPUT_WORK_PATH}'\n$project_file = Get-ChildItem -Path '${KIPRJMOD}' -Filter '*.kicad_pro' | Select-Object -First 1\n$project_name = $project_file.BaseName\n\nCompress-Archive -Path ($tmp_location + '\\*') -DestinationPath ($tmp_location + $project_name + '-Gerbers.zip')\n\n\"",
        "description": "",
        "ignore_exit_code": false,
        "output_filename": "",
        "record_output": false
      },
      "type": "special_execute"
    },
    {
      "description": "Generate Full Bill of Materials",
      "id": "ccb89609-c924-4fb9-8f5e-cf5a4e1d28d0",
      "settings": {
        "bom_format_preset_name": "CSV",
        "bom_preset_name": "",
        "description": "",
        "exclude_dnp": false,

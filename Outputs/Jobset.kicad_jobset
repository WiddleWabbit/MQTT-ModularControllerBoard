        "sort_asc": true,
        "sort_field": "${ITEM_NUMBER}",
        "string_delimiter": "\""
      },
      "type": "sch_export_bom"
    },
    {
      "description": "Create JLCPCB BOM",
      "id": "c895861f-76c0-4de1-99df-4d562233c447",
      "settings": {
        "command": "powershell.exe -Command \"\n\n$tmp_location = '${JOBSET_OUTPUT_WORK_PATH}'\n\n$project_file = Get-ChildItem -Path '${KIPRJMOD}' -Filter '*.kicad_pro' | Select-Object -First 1\n$project_name = $project_file.BaseName\n\n$inputFile = \\\"${tmp_location}\\\" + 'BOM.csv'\n$outputFile = \\\"${tmp_location}\\\" + 'JLCPCB_BOM.csv'\n\nImport-Csv -Path $inputFile | \n    Select-Object @{Name='Comment'; Expression={$_.Value}}, \n                  @{Name='Designator'; Expression={$_.Reference}}, \n                  @{Name='Footprint'; Expression={$_.Package}}, \n                  'JLCPCB Part #' | \n    Export-Csv -Path $outputFile -NoTypeInformation\n\n\"",
        "description": "",
        "ignore_exit_code": false,
        "output_filename": "",
        "record_output": false
      },
      "type": "special_execute"
    },
    {
      "description": "",
      "id": "03e5fc2a-1174-4ab7-b57f-f3c1b156a7af",
      "settings": {

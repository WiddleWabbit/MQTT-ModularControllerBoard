    },
    {
      "description": "Generate JLCPCB Position Files",
      "id": "534389d0-2e0c-4d33-bd64-098d5f1f562f",
      "settings": {
        "command": "powershell.exe -Command \"\n\n$tmp_location = '${JOBSET_OUTPUT_WORK_PATH}'\n\n$project_file = Get-ChildItem -Path '${KIPRJMOD}' -Filter '*.kicad_pro' | Select-Object -First 1\n$project_name = $project_file.BaseName\n\n$topFile = \\\"${tmp_location}\\\" + \\\"${project_name}\\\"+ '-top-pos.csv'\n$bottomFile = \\\"${tmp_location}\\\" + \\\"${project_name}\\\"+ '-bottom-pos.csv'\n$outputFile = \\\"${tmp_location}\\\" + 'JLCPCB_POS.csv'\n\n$posData = @(Import-Csv -Path $topFile -ErrorAction SilentlyContinue) + @(Import-Csv -Path $bottomFile -ErrorAction SilentlyContinue)\n\n$posData | \n    Select-Object @{Name='Designator'; Expression={$_.Ref}}, \n                  @{Name='Mid X'; Expression={$_.PosX}}, \n                  @{Name='Mid Y'; Expression={$_.PosY}}, \n                  @{Name='Layer'; Expression={$_.Side}}, \n                  @{Name='Rotation'; Expression={$_.Rot}} |\n    Export-Csv -Path $outputFile -NoTypeInformation\n\n\"",
        "description": "",
        "ignore_exit_code": false,
        "output_filename": "",
        "record_output": false
      },
      "type": "special_execute"
    },

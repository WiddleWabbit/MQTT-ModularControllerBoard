    {
      "description": "Rename Drawings",
      "id": "c4d53ff8-277a-447f-a0e6-9a65db793e6a",
      "settings": {
        "command": "powershell.exe -Command \"\n\n$tmp_location = '${JOBSET_OUTPUT_WORK_PATH}'\n\n$project_file = Get-ChildItem -Path '${KIPRJMOD}' -Filter '*.kicad_pro' | Select-Object -First 1\n$project_name = $project_file.BaseName\n\n$renameMatrix = @(\n    @(\\\"${tmp_location}\\\", ($project_name + '.pdf'), ($project_name + '-Schematic.pdf')),\n    @(\\\"${tmp_location}\\\", ($project_name + '-F_Fab.pdf'), ($project_name + '-Front-Fabrication.pdf')),\n    @(\\\"${tmp_location}\\\", ($project_name + '-B_Fab.pdf'), ($project_name + '-Back-Fabrication.pdf')),\n    @(\\\"${tmp_location}\\\", ($project_name + '-F_Silkscreen.pdf'), ($project_name + '-Front-Silkscreen.pdf')),\n    @(\\\"${tmp_location}\\\", ($project_name + '-B_Silkscreen.pdf'), ($project_name + '-Back-Silkscreen.pdf'))\n)\n\nforeach ($row in $renameMatrix) {\n    $folder   = $row[0]\n    $oldName  = $row[1]\n    $newName  = $row[2]\n    \n    $fullOldPath = Join-Path -Path $folder -ChildPath $oldName\n\n    if (Test-Path -Path $fullOldPath) {\n        Rename-Item -Path $fullOldPath -NewName $newName -Force\n        Write-Host ('SUCCESS: Renamed ' + $oldName + ' -> ' + $newName)\n    } else {\n        Write-Warning ('SKIP: File not found at ' + $fullOldPath)\n    }\n}\n\n\"",
        "description": "",
        "ignore_exit_code": false,
        "output_filename": "c4d53ff8-277a-447f-a0e6-9a65db793e6a.log",
        "record_output": false
      },
      "type": "special_execute"
    },
